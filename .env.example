# ─────────────────────────────────────────────────────────────────────────────
# GrowthX — local environment.  Copy to `.env` and fill in.
# `.env` is gitignored. Never put any of these into the snippet, Site A, or the
# dashboard bundle — those are all public. See GUIDE.md §B7.
# ─────────────────────────────────────────────────────────────────────────────

# --- AWS (GUIDE.md §B1) ------------------------------------------------------
AWS_PROFILE=growthx
AWS_REGION=us-east-1

# --- Model provider (GUIDE.md §B2 and §B5) -----------------------------------
# Gemini is the provider. Bedrock is closed — see GUIDE.md §B2.
GX_MODEL_PROVIDER=gemini
# Unused; kept only so an old .env does not break. Nothing reads it.
GX_BEDROCK_INFERENCE_PROFILE_ID=

# Google Gemini (free tier). Strands has a first-party Gemini provider that
# reads GEMINI_API_KEY natively.
# Gemini PRO is NOT usable on the free tier (zero daily quota) — Flash only.
# Get a key at https://aistudio.google.com/apikey
# NOTE: gemini-2.5-flash is retired for new API keys — use a 3.x flash model.
# Verify what YOUR key can reach:  pnpm check:models
GEMINI_API_KEY=
GX_GEMINI_MODEL=gemini-3.6-flash

# --- Database (GUIDE.md §B9) -------------------------------------------------
# Neon Postgres. Use the POOLED endpoint — the hostname must contain "-pooler".
# Lambda opens many short-lived connections; the direct endpoint runs out under
# traffic-swarm load. Verify with: pnpm check:db
DATABASE_URL=

# --- Demo site ---------------------------------------------------------------
GX_SITE_ID=site_corrick
