{
  "name": "growthx",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "pnpm -r --if-present typecheck",
    "check:models": "node scripts/check-models.mjs",
    "check:db": "node scripts/check-db.mjs",
    "build:snippet": "pnpm --filter @growthx/snippet build",
    "dev:site-a": "pnpm --filter @growthx/site-a dev",
    "build:site-a": "pnpm --filter @growthx/site-a build && node scripts/inject-snippet.mjs",
    "deploy:infra": "pnpm build:snippet && pnpm build:site-a && pnpm build:dashboard && pnpm secrets:push && pnpm --filter @growthx/infra run deploy && node scripts/upload-static.mjs && node scripts/outputs.mjs",
    "seed:experiment": "node scripts/seed-experiment.mjs",
    "query:events": "node scripts/query-events.mjs",
    "dump:snapshot": "tsx scripts/dump-snapshot.mjs",
    "spike:selectors": "tsx scripts/selector-spike.mjs",
    "swarm": "tsx swarm/run.ts",
    "screenshot": "node scripts/screenshot.mjs",
    "agent:run": "packages/agent/.venv/bin/python -m growthx_agent.orchestrator",
    "agent:evaluate": "packages/agent/.venv/bin/python -m growthx_agent.orchestrator evaluate",
    "e2e": "node scripts/not-yet.mjs e2e P21",
    "db:push": "pnpm --filter @growthx/db push",
    "db:studio": "pnpm --filter @growthx/db studio",
    "secrets:push": "node scripts/put-secrets.mjs",
    "cdk:diff": "pnpm --filter @growthx/infra run diff",
    "check:site-a": "node scripts/check-site-a.mjs",
    "check:flicker": "node scripts/check-flicker.mjs",
    "check:diff": "node scripts/check-diff.mjs",
    "check:policy": "node scripts/check-policy.mjs",
    "check:approvals": "tsx scripts/check-approvals.mjs",
    "check:results": "tsx scripts/check-results.mjs",
    "demo:queue": "tsx scripts/demo-queue.mjs",
    "check:ingestion": "node scripts/check-ingestion.mjs",
    "capture:snapshot": "node scripts/capture-snapshot.mjs",
    "aggregate": "tsx scripts/aggregate.mjs",
    "digests": "tsx scripts/digests.mjs",
    "build:dashboard": "pnpm --filter @growthx/dashboard build",
    "dev:dashboard": "pnpm --filter @growthx/dashboard dev",
    "seed:learnings": "node scripts/seed-learnings.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.24.2",
    "playwright": "^1.63.0",
    "postgres": "^3.4.9",
    "tsx": "^4.23.13",
    "typescript": "^5.6.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
